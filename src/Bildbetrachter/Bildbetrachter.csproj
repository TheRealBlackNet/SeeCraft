<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Bildbetrachter</AssemblyName>
    <RootNamespace>Bildbetrachter</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- GC-Einstellungen fuer ruckelfreies Blaettern (landen in Bildbetrachter.runtimeconfig.json) -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>true</RetainVMGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- ImageMagick (Apache-2.0): WebP, HEIC, AVIF, JPEG XL, TGA, PSD, JPEG 2000 ... -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.*" />
    <!-- Animierte GIFs (Apache-2.0) -->
    <PackageReference Include="WpfAnimatedGif" Version="2.*" />
  </ItemGroup>

</Project>
