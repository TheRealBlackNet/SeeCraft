<Window x:Class="Bildbetrachter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Bildbetrachter"
        Title="Bildbetrachter" Width="1100" Height="700" MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Grid>
        <!-- ===== Ansicht "Liste": Ordner | Vorschau | Bildliste ===== -->
        <Grid x:Name="ListRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="120" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="380" MinWidth="120" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="150" />
            </Grid.ColumnDefinitions>

            <!-- aktueller Ordner (am oberen Rand, über die ganze Breite) -->
            <TextBox x:Name="FolderBox" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5"
                     IsReadOnly="True" IsReadOnlyCaretVisible="True" Padding="6,3"
                     VerticalContentAlignment="Center" BorderThickness="0,0,0,1"
                     BorderBrush="#FFD0D0D0" Background="#FFF7F7F7" />

            <TreeView x:Name="FolderTree" Grid.Row="1" Grid.Column="0" SelectedItemChanged="FolderTree_SelectedItemChanged" />
            <GridSplitter Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Background="#FFD0D0D0" />

            <!-- Vorschau: auf Spaltenbreite eingepasst -->
            <Grid Grid.Row="1" Grid.Column="2" Background="#FF1E1E1E">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="PreviewScroll" Grid.Row="0"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="Both"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </ScrollViewer>

                <Button x:Name="InfoButton" Grid.Row="0" Content="ⓘ" FontFamily="Segoe UI Symbol" FontSize="15"
                        Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,6,18,0" Visibility="Collapsed" Click="InfoButton_Click"
                        ToolTip="Enthält Bild-Metadaten (z. B. Prompt) – klicken zum Anzeigen/Verbergen" />

                <Border x:Name="InfoPanel" Grid.Row="1" Background="#FF2B2B2B" Padding="8" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="InfoText" Foreground="#FFE0E0E0" TextWrapping="Wrap" FontFamily="Consolas" />
                        <StackPanel x:Name="MetaPanel" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBox x:Name="MetaBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="170"
                                     VerticalScrollBarVisibility="Auto" />
                            <Button Content="Kopieren" HorizontalAlignment="Right" Margin="0,6,0,0" Padding="12,3"
                                    Click="CopyMeta_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="1" Grid.Column="3" HorizontalAlignment="Stretch" Background="#FFD0D0D0" />

            <ListView x:Name="FileList" Grid.Row="1" Grid.Column="4" SelectionMode="Single"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      SelectionChanged="FileList_SelectionChanged"
                      MouseDoubleClick="FileList_MouseDoubleClick"
                      PreviewMouseRightButtonDown="FileList_PreviewMouseRightButtonDown"
                      KeyDown="FileList_KeyDown">
                <ListView.Resources>
                    <!-- Zelle der Miniatur-Spalte (50 x 50) -->
                    <DataTemplate x:Key="ThumbCell">
                        <Image Source="{Binding Thumbnail}" Width="50" Height="50" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </DataTemplate>
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="230" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Geändert" Width="130" DisplayMemberBinding="{Binding ModifiedText}" />
                        <GridViewColumn Header="Größe" Width="80" DisplayMemberBinding="{Binding SizeText}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <!-- ===== Ansicht "Bild" ===== -->
        <Grid x:Name="ViewerRoot" Visibility="Collapsed" Background="Black">
            <local:ZoomView x:Name="Viewer" />
        </Grid>
    </Grid>
</Window>
